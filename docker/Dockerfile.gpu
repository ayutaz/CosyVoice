FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV LD_LIBRARY_PATH=/usr/local/cuda-11.8/targets/x86_64-linux/lib:/usr/local/cuda-11.8/lib64:${LD_LIBRARY_PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-venv python3-pip \
    libsndfile1 ffmpeg \
    cuda-nvrtc-11-8 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/local/cuda-11.8/targets/x86_64-linux/lib/libnvrtc.so.11.8.89 \
              /usr/local/cuda-11.8/targets/x86_64-linux/lib/libnvrtc.so \
    && ldconfig

RUN python3.10 -m pip install --no-cache-dir \
    "numpy<2" pyarrow

RUN python3.10 -m pip install --no-cache-dir \
    onnxruntime-gpu==1.18.0 \
    torch==2.1.2+cu118 torchaudio==2.1.2+cu118 \
    --extra-index-url https://download.pytorch.org/whl/cu118

RUN python3.10 -m pip install --no-cache-dir \
    openai-whisper

WORKDIR /workspace
